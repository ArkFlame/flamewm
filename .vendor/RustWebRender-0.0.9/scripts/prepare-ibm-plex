#!/usr/bin/env bash
set -euo pipefail
SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
ROOT="$(cd "$(dirname "$SCRIPT_PATH")/.." && pwd -P)"
cd "$ROOT"

# RustWebRender never redistributes font binaries. This helper only exposes a
# system-installed IBM Plex Sans or extracts a user-supplied archive into the
# ignored target/ directory for this process tree.
if command -v fc-match >/dev/null 2>&1; then
  FAMILY="$(fc-match -f '%{family[0]}\n' 'IBM Plex Sans' 2>/dev/null | head -n1 || true)"
  if [[ "$FAMILY" == "IBM Plex Sans" ]]; then
    exit 0
  fi
fi

ZIP="${1:-${RWR_IBM_PLEX_ZIP:-}}"
if [[ -z "$ZIP" ]]; then
  shopt -s nullglob
  CANDIDATES=(
    "$PWD"/IBM_Plex_Sans*.zip
    "$PWD"/../IBM_Plex_Sans*.zip
    "$HOME"/Downloads/IBM_Plex_Sans*.zip
  )
  shopt -u nullglob
  if ((${#CANDIDATES[@]})); then
    ZIP="${CANDIDATES[0]}"
  fi
fi

if [[ -z "$ZIP" ]]; then
  echo "RWR_FONT_NOTE IBM Plex Sans is not installed and no IBM_Plex_Sans*.zip was found; Xft will use Noto/DejaVu fallback." >&2
  exit 0
fi
if [[ ! -f "$ZIP" ]]; then
  echo "RWR_FONT_ERROR archive not found: $ZIP" >&2
  exit 1
fi
command -v unzip >/dev/null 2>&1 || {
  echo "RWR_FONT_ERROR unzip is required to use $ZIP without system installation" >&2
  exit 1
}

OUT="$PWD/target/rwr/fonts/ibm-plex-sans"
rm -rf "$OUT"
mkdir -p "$OUT"

# The supplied Google Fonts archive uses these canonical static face names.
# Match by basename so minor parent-directory layout differences do not matter.
for FACE in Regular Medium SemiBold Bold; do
  MATCH="$(unzip -Z1 "$ZIP" | awk -F/ -v f="IBMPlexSans-${FACE}.ttf" '$NF == f { print; exit }')"
  if [[ -z "$MATCH" ]]; then
    echo "RWR_FONT_ERROR $ZIP does not contain IBMPlexSans-${FACE}.ttf" >&2
    exit 1
  fi
  unzip -p "$ZIP" "$MATCH" > "$OUT/IBMPlexSans-${FACE}.ttf"
done

FILES=(
  "$OUT/IBMPlexSans-Regular.ttf"
  "$OUT/IBMPlexSans-Medium.ttf"
  "$OUT/IBMPlexSans-SemiBold.ttf"
  "$OUT/IBMPlexSans-Bold.ttf"
)
printf '%s\n' "$(IFS=:; echo "${FILES[*]}")"
echo "RWR_FONT_NOTE using process-local IBM Plex Sans from $ZIP" >&2
