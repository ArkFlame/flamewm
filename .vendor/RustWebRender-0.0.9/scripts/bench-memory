#!/usr/bin/env bash
set -euo pipefail
SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
ROOT="$(cd "$(dirname "$SCRIPT_PATH")/.." && pwd -P)"
cd "$ROOT"

command -v Xephyr >/dev/null || { echo "Xephyr required for this benchmark" >&2; exit 1; }
command -v smem >/dev/null || { echo "smem required for PSS measurement" >&2; exit 1; }

cargo build --release -p rustwebrender-compiler -p rustwebrender-x11
mkdir -p target/rwr
target/release/rwr-compile -o target/rwr/flamewm-v8.rwr examples/flamewm-v8/index.html

DISPLAY_NUM="${RWR_BENCH_DISPLAY:-:98}"
SCREEN="${RWR_BENCH_SCREEN:-1365x647}"
Xephyr "$DISPLAY_NUM" -screen "$SCREEN" -ac -br >/tmp/rwr-bench-xephyr.log 2>&1 &
xephyr_pid=$!
rwr_pid=''
trap 'kill "$xephyr_pid" ${rwr_pid:-} 2>/dev/null || true' EXIT INT TERM
sleep 1
DISPLAY="$DISPLAY_NUM" target/release/rwr-flamewm-demo target/rwr/flamewm-v8.rwr >/tmp/rwr-actions.log 2>&1 &
rwr_pid=$!
sleep 1
smem -P 'rwr-flamewm-demo' -c 'pid pss rss command'
