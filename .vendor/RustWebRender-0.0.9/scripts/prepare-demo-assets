#!/usr/bin/env bash
set -euo pipefail

SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
ROOT="$(cd "$(dirname "$SCRIPT_PATH")/.." && pwd -P)"
SRC="$ROOT/reference/flamewm-html-css-js-v8/assets"
OUT="$ROOT/examples/flamewm-v8/assets"
MAGICK="${MAGICK:-$(command -v magick || true)}"
INKSCAPE="${INKSCAPE:-$(command -v inkscape || true)}"

[[ -n "$MAGICK" ]] || { echo "prepare-demo-assets: ImageMagick 'magick' is required" >&2; exit 1; }
[[ -n "$INKSCAPE" ]] || { echo "prepare-demo-assets: Inkscape is required for SVG rasterization" >&2; exit 1; }
mkdir -p "$OUT"
rm -f "$OUT"/*.ppm
TMP="$(mktemp -d)"
trap 'rm -rf "$TMP"' EXIT

# RWRB/2 keeps RGB8 assets. 0.0.9 reserves pure magenta (#ff00ff) as an
# image transparency key. The X11 backend turns keyed pixels into an X clip
# mask, removing the old black/gray image rectangles without adding GTK/Qt.
svg_png() {
  local source="$1" width="$2" height="$3" mode="${4:-preserve}"
  local stem
  stem="$(basename "$source" .svg)-${width}x${height}-${mode}-$RANDOM"
  local work="$source"
  if [[ "$source" == *.svg && "$mode" == mono ]]; then
    work="$TMP/$stem.svg"
    # Breeze symbolic assets encode currentColor as #232629. Recolor only the
    # symbolic foreground; full-color artwork uses preserve mode.
    sed -e 's/#232629/#e4e8ea/g' -e 's/#31363b/#e4e8ea/g' "$source" > "$work"
  fi
  local png="$TMP/$stem.png"
  if [[ "$work" == *.svg ]]; then
    "$INKSCAPE" "$work" --export-filename="$png" --export-width="$width" --export-height="$height" --export-background-opacity=0 >/dev/null 2>&1
  else
    "$MAGICK" "$work" -resize "${width}x${height}" -background none -gravity center -extent "${width}x${height}" "$png"
  fi
  printf '%s\n' "$png"
}

keyed() {
  local source="$1" width="$2" height="$3" output="$4" mode="${5:-preserve}"
  local png
  png="$(svg_png "$source" "$width" "$height" "$mode")"
  # Threshold alpha before flattening so the reserved key stays exact and does
  # not produce magenta antialias fringes. Xft handles text antialiasing; shell
  # glyphs remain crisp at their native small sizes.
  "$MAGICK" "$png" \
    -alpha set -channel A -threshold 42% +channel \
    -background '#ff00ff' -alpha background -alpha remove -alpha off \
    -depth 8 "ppm:$OUT/$output"
}

flat() {
  local source="$1" width="$2" height="$3" background="$4" output="$5" opacity="${6:-100}"
  local input="$source"
  if [[ "$source" == *.svg ]]; then input="$(svg_png "$source" "$width" "$height" preserve)"; fi
  "$MAGICK" "$input" -resize "${width}x${height}" -background none -gravity center -extent "${width}x${height}" \
    -alpha set -channel A -evaluate multiply "$(awk "BEGIN{print $opacity/100}")" +channel \
    -background "$background" -alpha background -alpha remove -alpha off -depth 8 "ppm:$OUT/$output"
}

# Exact viewport wallpaper used by the browser prototype (background-size: cover).
"$MAGICK" "$SRC/images/flamewm-default-wallpaper.webp" -resize '1350x641^' -gravity center -extent 1350x641 -depth 8 "ppm:$OUT/wallpaper.ppm"
flat "$SRC/flamewm.png" 300 100 '#202326' logo-about.ppm 92
flat "$SRC/flamewm.png" 142 34 '#1b1e20' logo-sidebar.ppm 96
# Watermark stays translucent over the actual wallpaper by precompositing onto a
# crop taken from the final wallpaper at its fixed prototype position.
"$MAGICK" "$SRC/flamewm.png" -resize 220x74 -alpha set -channel A -evaluate multiply 0.28 +channel "$TMP/watermark.png"
"$MAGICK" "$OUT/wallpaper.ppm" -crop 220x74+1106+512 +repage "$TMP/watermark.png" -gravity center -composite -depth 8 "ppm:$OUT/watermark.ppm"

# Desktop icons.
keyed "$SRC/breeze/user-home.svg" 44 44 desktop-home.ppm preserve
keyed "$SRC/breeze/folder-downloads.svg" 44 44 desktop-downloads.ppm preserve
keyed "$SRC/breeze/folder.svg" 44 44 desktop-projects.ppm preserve
keyed "$SRC/breeze/internet-web-browser.svg" 44 44 desktop-browser.ppm preserve
keyed "$SRC/breeze/user-trash.svg" 44 44 desktop-trash.ppm preserve
keyed "$SRC/breeze/folder-new-visible.svg" 44 44 desktop-new-folder.ppm preserve

# Window controls and title icons: symbolic white, genuinely transparent.
keyed "$SRC/breeze/preferences-system.svg" 16 16 title-settings.ppm preserve
keyed "$SRC/breeze/utilities-terminal.svg" 16 16 title-terminal.ppm preserve
keyed "$SRC/breeze/window-minimize.svg" 13 13 title-minimize.ppm mono
keyed "$SRC/breeze/window-maximize.svg" 13 13 title-maximize.ppm mono
keyed "$SRC/breeze/window-restore.svg" 13 13 title-restore.ppm mono
keyed "$SRC/breeze/window-close.svg" 13 13 title-close.ppm mono
# The destructive close hover is square on three corners. This tiny keyed mask
# clips only the frame's outer top-right corner to the window radius.
"$MAGICK" -size 9x9 xc:'#272a2d' +antialias -fill '#ff00ff' -draw 'circle 0,9 0,0' -depth 8 "ppm:$OUT/close-top-right-mask.ppm"

# Settings semantic icons. The three source-proven symbolic roles are explicitly
# recolored; appearance/desktop/about retain their intended Breeze artwork.
keyed "$SRC/breeze/settings-appearance.svg" 20 20 nav-appearance.ppm preserve
keyed "$SRC/breeze/settings-desktop.svg" 20 20 nav-desktop.ppm preserve
keyed "$SRC/breeze/configure.svg" 20 20 nav-taskbar.ppm mono
keyed "$SRC/breeze/settings-displays.svg" 20 20 nav-displays.ppm mono
keyed "$SRC/breeze/settings-fonts.svg" 20 20 nav-fonts.ppm mono
keyed "$SRC/breeze/settings-hotkeys.svg" 20 20 nav-hotkeys.ppm mono
keyed "$SRC/breeze/settings-about.svg" 20 20 nav-about.ppm preserve

# About.
keyed "$SRC/paypal.svg" 18 18 about-paypal.ppm preserve
keyed "$SRC/github.svg" 18 18 about-github.ppm mono
keyed "$SRC/breeze/internet-web-browser.svg" 18 18 about-web.ppm preserve

# Desktop context menu.
keyed "$SRC/breeze/utilities-terminal.svg" 16 16 menu-terminal.ppm preserve
keyed "$SRC/breeze/folder-new-visible.svg" 16 16 menu-folder.ppm mono
keyed "$SRC/sticky-note.svg" 16 16 menu-note.ppm preserve
keyed "$SRC/breeze/preferences-desktop-wallpaper.svg" 16 16 menu-wallpaper.ppm preserve

# Start categories and applications.
keyed "$SRC/breeze/applications-development.svg" 20 20 start-development.ppm preserve
keyed "$SRC/breeze/applications-games.svg" 20 20 start-games.ppm preserve
keyed "$SRC/breeze/applications-graphics.svg" 20 20 start-graphics.ppm preserve
keyed "$SRC/breeze/internet-visible.svg" 20 20 start-internet.ppm mono
keyed "$SRC/breeze/applications-multimedia.svg" 20 20 start-multimedia.ppm preserve
keyed "$SRC/breeze/applications-system.svg" 20 20 start-system.ppm preserve
keyed "$SRC/breeze/applications-utilities.svg" 20 20 start-utilities.ppm preserve
keyed "$SRC/breeze/system-shutdown-visible.svg" 20 20 start-power.ppm mono
keyed "$SRC/breeze/go-next.svg" 12 12 start-chevron.ppm mono
keyed "$SRC/breeze/search-visible.svg" 15 15 start-search.ppm mono
keyed "$SRC/breeze/system-file-manager.svg" 20 20 start-files.ppm preserve
keyed "$SRC/breeze/utilities-terminal.svg" 20 20 start-terminal.ppm preserve
keyed "$SRC/breeze/preferences-system.svg" 20 20 start-settings.ppm preserve
keyed "$SRC/breeze/internet-web-browser.svg" 20 20 start-web.ppm preserve
keyed "$SRC/breeze/kate.svg" 20 20 start-kate.ppm preserve
keyed "$SRC/breeze/kcalc.svg" 20 20 start-kcalc.ppm preserve
keyed "$SRC/breeze/elisa.svg" 20 20 start-elisa.ppm preserve
keyed "$SRC/breeze/kwrite.svg" 20 20 start-kwrite.ppm preserve
keyed "$SRC/breeze/ark.svg" 20 20 start-ark.ppm preserve
keyed "$SRC/breeze/spectacle.svg" 20 20 start-spectacle.ppm preserve
keyed "$SRC/breeze/okular.svg" 20 20 start-okular.ppm preserve
keyed "$SRC/breeze/gwenview.svg" 20 20 start-gwenview.ppm preserve
keyed "$SRC/breeze/kdenlive.svg" 20 20 start-kdenlive.ppm preserve
keyed "$SRC/breeze/applications-development.svg" 20 20 start-code.ppm preserve
keyed "$SRC/breeze/system-lock-screen-visible.svg" 20 20 start-lock.ppm mono
keyed "$SRC/breeze/system-log-out-visible.svg" 20 20 start-logout.ppm mono
keyed "$SRC/breeze/system-reboot-visible.svg" 20 20 start-reboot.ppm mono

# Taskbar/tray: shell indicators are white/bright exactly like the web prototype.
keyed "$SRC/flamewm-icon.svg" 25 25 task-start.ppm preserve
keyed "$SRC/breeze/internet-web-browser.svg" 25 25 task-browser.ppm preserve
keyed "$SRC/breeze/system-file-manager.svg" 25 25 task-files.ppm preserve
keyed "$SRC/breeze/utilities-terminal.svg" 25 25 task-terminal.ppm preserve
keyed "$SRC/breeze/applications-development.svg" 25 25 task-code.ppm preserve
keyed "$SRC/breeze/preferences-system.svg" 25 25 task-settings.ppm preserve
# V8 contract: Pin is list-add; Unpin uses the minimize/remove visual role.
keyed "$SRC/breeze/list-add-visible.svg" 16 16 task-pin.ppm mono
keyed "$SRC/breeze/window-minimize.svg" 16 16 task-unpin.ppm mono
keyed "$SRC/breeze/media-playback-start.svg" 17 17 tray-play.ppm mono
keyed "$SRC/breeze/media-playback-pause.svg" 17 17 tray-pause.ppm mono
keyed "$SRC/breeze/media-skip-backward.svg" 20 20 media-prev.ppm mono
keyed "$SRC/breeze/media-playback-start.svg" 20 20 media-play.ppm mono
keyed "$SRC/breeze/media-playback-pause.svg" 20 20 media-pause.ppm mono
keyed "$SRC/breeze/media-skip-forward.svg" 20 20 media-next.ppm mono
keyed "$SRC/breeze/audio-volume-high.svg" 17 17 tray-volume.ppm mono
keyed "$SRC/breeze/audio-volume-muted.svg" 17 17 tray-volume-muted.ppm mono
keyed "$SRC/breeze/audio-volume-high.svg" 20 20 popup-volume.ppm mono
keyed "$SRC/breeze/audio-volume-muted.svg" 20 20 popup-muted.ppm mono
keyed "$SRC/breeze/network-wireless.svg" 17 17 tray-wifi.ppm mono

echo "prepared $(find "$OUT" -maxdepth 1 -type f -name '*.ppm' | wc -l) RustWebRender 0.0.9 prototype assets"
