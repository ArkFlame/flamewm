#!/usr/bin/env bash
set -euo pipefail
SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
ROOT="$(cd "$(dirname "$SCRIPT_PATH")/.." && pwd -P)"
cd "$ROOT"

# Correctness remains tested in the normal test profile. The interactive path is
# deliberately built in release mode too: 0.0.9 treats release latency as part
# of the product contract rather than letting ./check validate only a slow debug
# renderer that ./xephyr never runs.
cargo test --workspace
cargo build --quiet --release -p rustwebrender-compiler --bin rwr-compile --bin rwr-inspect
cargo build --quiet --release -p rustwebrender-x11 --bin rwr-flamewm-demo

mkdir -p target/rwr
./target/release/rwr-compile \
  -o target/rwr/flamewm-v8.rwr examples/flamewm-v8/index.html
./target/release/rwr-inspect target/rwr/flamewm-v8.rwr | \
  grep -E '^(format=RWRB/2|assets=|nodes=|variables=)' >/dev/null

# Prototype isolation invariant: the showcase must never launch or mutate host-OS
# applications/services. All app/session/About behavior stays inside the virtual
# RustWebRender desktop state machine.
if grep -Eq 'std::process::Command|Command::new|xdg-open|gio[[:space:]]+open|system\(' \
  crates/rustwebrender-x11/src/bin/rwr-flamewm-demo.rs; then
  echo 'ERROR virtual FlameWM demo contains a host-OS launch hook' >&2
  exit 1
fi

# Distribution invariant: font binaries are never committed/bundled. They may
# exist only below ignored target/ after prepare-ibm-plex runs locally.
if find . -path './target' -prune -o -type f \( -iname '*.ttf' -o -iname '*.otf' -o -iname '*.woff' -o -iname '*.woff2' \) -print | grep -q .; then
  echo 'ERROR packaged source contains font binaries' >&2
  exit 1
fi
printf 'OK RustWebRender 0.0.9 tests + release renderer + full FlameWM prototype compile/inspect smoke test\n'
