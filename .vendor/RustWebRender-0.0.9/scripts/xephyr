#!/usr/bin/env bash
set -euo pipefail
SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
ROOT="$(cd "$(dirname "$SCRIPT_PATH")/.." && pwd -P)"
cd "$ROOT"

command -v Xephyr >/dev/null || { echo "Xephyr is required (Ubuntu/Debian: sudo apt install xserver-xephyr)" >&2; exit 1; }
command -v cargo >/dev/null || { echo "cargo is required" >&2; exit 1; }
command -v xdpyinfo >/dev/null || { echo "xdpyinfo is required (package: x11-utils)" >&2; exit 1; }

if [[ -z "${DISPLAY:-}" ]]; then
  echo "Host DISPLAY is unset; Xephyr needs the current desktop X display to create its outer window." >&2
  exit 1
fi

SCREEN="${RWR_XEPHYR_SCREEN:-1350x641}"
export RWR_UI_FONT="${RWR_UI_FONT:-IBM Plex Sans}"
if [[ -z "${RWR_FONT_FILES:-}" ]]; then
  FONT_FILES="$(./scripts/prepare-ibm-plex || true)"
  if [[ -n "$FONT_FILES" ]]; then
    export RWR_FONT_FILES="$FONT_FILES"
  fi
fi

mkdir -p target/rwr

# Build everything before opening the nested desktop. This avoids a blank Xephyr
# window sitting idle while Cargo compiles and removes the server/client race that
# existed in 0.0.3.
cargo build --quiet --release -p rustwebrender-compiler --bin rwr-compile
cargo build --quiet --release -p rustwebrender-x11 --bin rwr-flamewm-demo
./target/release/rwr-compile -o target/rwr/flamewm-v8.rwr examples/flamewm-v8/index.html

# Explicit display wins. Otherwise choose the first genuinely unused nested
# display so a stale :97 cannot make the demo connect to the wrong X server.
if [[ -n "${RWR_XEPHYR_DISPLAY:-}" ]]; then
  DISPLAY_NUM="$RWR_XEPHYR_DISPLAY"
  [[ "$DISPLAY_NUM" == :* ]] || DISPLAY_NUM=":$DISPLAY_NUM"
  if DISPLAY="$DISPLAY_NUM" xdpyinfo >/dev/null 2>&1; then
    echo "Requested nested display $DISPLAY_NUM is already in use. Choose another with RWR_XEPHYR_DISPLAY=:N." >&2
    exit 1
  fi
else
  DISPLAY_NUM=""
  for number in $(seq 97 119); do
    candidate=":$number"
    if ! DISPLAY="$candidate" xdpyinfo >/dev/null 2>&1; then
      DISPLAY_NUM="$candidate"
      break
    fi
  done
  if [[ -z "$DISPLAY_NUM" ]]; then
    echo "No free Xephyr display found in :97..:119; set RWR_XEPHYR_DISPLAY=:N explicitly." >&2
    exit 1
  fi
fi

LOG="target/rwr/xephyr.log"
: >"$LOG"

# IMPORTANT: -noreset is intentional. In 0.0.3 the launcher used -terminate.
# The readiness probe (`xdpyinfo`) connected and disconnected before the demo,
# which caused an X server reset and therefore terminated Xephyr. The subsequent
# demo then failed XOpenDisplay. -noreset guarantees the nested server survives
# readiness probes and other temporary client disconnects while the user tests.
Xephyr "$DISPLAY_NUM" \
  -screen "$SCREEN" \
  -dpi 96 \
  -ac \
  -br \
  -noreset \
  -nolisten tcp \
  >"$LOG" 2>&1 &
XPID=$!

cleanup() {
  if kill -0 "$XPID" 2>/dev/null; then
    kill "$XPID" 2>/dev/null || true
    wait "$XPID" 2>/dev/null || true
  fi
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

ready=0
for _ in $(seq 1 100); do
  # Never accept an existing/unrelated server: our spawned Xephyr must still be
  # alive at the same time the display answers.
  if ! kill -0 "$XPID" 2>/dev/null; then
    cat "$LOG" >&2 || true
    echo "Xephyr exited before becoming ready on $DISPLAY_NUM" >&2
    exit 1
  fi
  if DISPLAY="$DISPLAY_NUM" xdpyinfo >/dev/null 2>&1; then
    ready=1
    break
  fi
  sleep 0.05
done
if [[ "$ready" != 1 ]]; then
  cat "$LOG" >&2 || true
  echo "Xephyr did not become ready on $DISPLAY_NUM" >&2
  exit 1
fi

# The readiness client has now disconnected. Prove the interactive server really
# survived before handing the display to RustWebRender.
sleep 0.10
if ! kill -0 "$XPID" 2>/dev/null; then
  cat "$LOG" >&2 || true
  echo "Xephyr died after the readiness probe; interactive server did not persist" >&2
  exit 1
fi

printf 'RustWebRender 0.0.9 interactive Xephyr ready on %s (%s)\n' "$DISPLAY_NUM" "$SCREEN"
printf 'Close the Xephyr window or press Ctrl+C here to stop the prototype.\n'

# Keep the Rust renderer in the foreground. Its X11 event loop intentionally
# runs until the nested display/window is closed, so ./xephyr remains attached
# for hands-on testing instead of behaving like ./verify-visual.
DISPLAY="$DISPLAY_NUM" ./target/release/rwr-flamewm-demo target/rwr/flamewm-v8.rwr
