#!/usr/bin/env bash
set -u
SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
ROOT="$(cd "$(dirname "$SCRIPT_PATH")/.." && pwd -P)"
cd "$ROOT"

status=0
check_required() {
  local cmd="$1" hint="$2"
  if command -v "$cmd" >/dev/null 2>&1; then
    printf 'OK       %-16s %s\n' "$cmd" "$(command -v "$cmd")"
  else
    printf 'MISSING  %-16s %s\n' "$cmd" "$hint"
    status=1
  fi
}
check_optional() {
  local cmd="$1" hint="$2"
  if command -v "$cmd" >/dev/null 2>&1; then
    printf 'OK       %-16s %s\n' "$cmd" "$(command -v "$cmd")"
  else
    printf 'OPTIONAL %-16s %s\n' "$cmd" "$hint"
  fi
}
lib_available() {
  local regex="$1"
  ldconfig -p 2>/dev/null | grep -Eq "$regex"
}

echo "RustWebRender 0.0.9 environment doctor"
if [[ -f "$ROOT/Cargo.toml" && -d "$ROOT/scripts" ]]; then
  printf 'OK       %-16s %s\n' "project root" "$ROOT"
else
  printf 'MISSING  %-16s %s\n' "project root" "failed to resolve package root from $SCRIPT_PATH"
  status=1
fi
check_required rustc "install Rust stable (rustup profile minimal is sufficient)"
check_required cargo "install Rust stable"
check_required pkg-config "install pkg-config"
if pkg-config --exists x11 2>/dev/null; then
  printf 'OK       %-16s %s\n' "X11 headers/libs" "$(pkg-config --modversion x11)"
else
  printf 'MISSING  %-16s %s\n' "X11 headers/libs" "install libx11-dev"
  status=1
fi
if lib_available 'libXrender\.so\.1'; then
  printf 'OK       %-16s %s\n' "XRender runtime" "libXrender.so.1 (true translucent overlays)"
else
  printf 'MISSING  %-16s %s\n' "XRender runtime" "install libxrender1; required for faithful translucent selection/snap overlays"
  status=1
fi
if lib_available 'libXft\.so\.2'; then
  printf 'OK       %-16s %s\n' "Xft runtime" "libXft.so.2"
else
  printf 'MISSING  %-16s %s\n' "Xft runtime" "install libxft2 for antialiased text"
  status=1
fi
if lib_available 'libfontconfig\.so\.1'; then
  printf 'OK       %-16s %s\n' "Fontconfig" "libfontconfig.so.1"
else
  printf 'MISSING  %-16s %s\n' "Fontconfig" "install libfontconfig1"
  status=1
fi
if command -v fc-match >/dev/null 2>&1 && [[ "$(fc-match -f '%{family[0]}' 'IBM Plex Sans' 2>/dev/null)" == "IBM Plex Sans" ]]; then
  printf 'OK       %-16s %s\n' "IBM Plex Sans" "system Fontconfig"
else
  printf 'OPTIONAL %-16s %s\n' "IBM Plex Sans" "./xephyr auto-loads a user-supplied IBM_Plex_Sans*.zip when found"
fi
check_optional unzip "needed only for process-local IBM Plex ZIP loading"
check_optional Xephyr "install xserver-xephyr for the default nested demo"
check_optional xdpyinfo "used to wait for Xephyr readiness"
check_optional xwininfo "used by ./verify-visual to detect the mapped demo"
if command -v magick >/dev/null 2>&1; then
  printf 'OK       %-16s %s\n' "ImageMagick" "$(command -v magick) (ImageMagick 7: magick import/identify/compare)"
elif command -v identify >/dev/null 2>&1 && command -v compare >/dev/null 2>&1; then
  printf 'OK       %-16s %s\n' "ImageMagick" "legacy identify/compare; standalone import or xwd needed for capture"
else
  printf 'OPTIONAL %-16s %s\n' "ImageMagick" "needed only by ./verify-visual pixel comparison"
fi
check_optional xwd "fallback screenshot backend when ImageMagick lacks X11 import support"
check_optional Xvfb "install xvfb for headless X11 checks"
check_optional smem "install smem for PSS measurements"
exit "$status"
