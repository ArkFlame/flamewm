#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd -P)"
VERSION="$(tr -d '[:space:]' < "$ROOT/FLAMEWM_VERSION")"
BUILD_DIR="$ROOT/.target/release"
DIST="$ROOT/.target/dist"
STAGE="$DIST/flamewm-$VERSION"
SOURCE_ARCHIVE="$DIST/flamewm-$VERSION-source.tar.gz"
LINUX_ARCHIVE="$DIST/flamewm-$VERSION-linux-x86_64.tar.gz"
DEB="$DIST/flamewm_${VERSION}_amd64.deb"

fail() { printf 'ERROR: %s\n' "$1" >&2; exit 1; }

[[ -n "$VERSION" ]] || fail 'FLAMEWM_VERSION is empty'
[[ -d "$BUILD_DIR" ]] || fail "missing release directory: $BUILD_DIR"
mkdir -p "$DIST"
rm -f "$SOURCE_ARCHIVE" "$LINUX_ARCHIVE" "$DEB" "$DIST/flamewm-$VERSION.tar.gz" "$DIST/SHA256SUMS"

for binary in flamewm flamewm-settings flamewm-render-x11 flamewm-render-compile flamewm-render-inspect; do
    [[ -x "$BUILD_DIR/$binary" ]] || fail "missing release binary: $BUILD_DIR/$binary"
done

for source in \
    "$ROOT/LICENSE" \
    "$ROOT/README.md" \
    "$ROOT/FLAMEWM_VERSION" \
    "$ROOT/docs/INSTALL.md" \
    "$ROOT/docs/PACKAGING.md" \
    "$ROOT/packaging/flamewm.desktop" \
    "$ROOT/packaging/install-manifest.txt" \
    "$ROOT/packaging/debian/control.in" \
    "$ROOT/packaging/debian/copyright"; do
    [[ -f "$source" ]] || fail "missing packaging source: $source"
done

rm -rf "$STAGE"
mkdir -p "$STAGE/usr/bin" "$STAGE/usr/share/flamewm" \
    "$STAGE/usr/share/applications" "$STAGE/usr/share/doc/flamewm" \
    "$STAGE/DEBIAN"

for binary in flamewm flamewm-settings flamewm-render-x11 flamewm-render-compile flamewm-render-inspect; do
    install -m 0755 "$BUILD_DIR/$binary" "$STAGE/usr/bin/$binary"
done
install -m 0644 "$ROOT/FLAMEWM_VERSION" "$STAGE/usr/share/flamewm/VERSION"
install -m 0644 "$ROOT/packaging/flamewm.desktop" "$STAGE/usr/share/applications/flamewm.desktop"
install -m 0644 "$ROOT/LICENSE" "$STAGE/usr/share/doc/flamewm/LICENSE"
install -m 0644 "$ROOT/README.md" "$STAGE/usr/share/doc/flamewm/README.md"
install -m 0644 "$ROOT/docs/INSTALL.md" "$STAGE/usr/share/doc/flamewm/INSTALL.md"
install -m 0644 "$ROOT/docs/PACKAGING.md" "$STAGE/usr/share/doc/flamewm/PACKAGING.md"
cp -a "$ROOT/assets" "$STAGE/usr/share/flamewm/assets"

if command -v dpkg-deb >/dev/null 2>&1; then
    sed -e "s/@VERSION@/$VERSION/g" "$ROOT/packaging/debian/control.in" > "$STAGE/DEBIAN/control"
    install -m 0644 "$ROOT/packaging/debian/copyright" "$STAGE/usr/share/doc/flamewm/copyright"
    dpkg-deb --build --root-owner-group "$STAGE" "$DEB" >/dev/null
fi
rm -rf "$STAGE/DEBIAN"

# Keep source and installable binary artifacts distinct and reproducible.
tar --sort=name --mtime="@${SOURCE_DATE_EPOCH:-0}" --owner=0 --group=0 --numeric-owner \
    -czf "$SOURCE_ARCHIVE" -C "$(dirname "$ROOT")" \
    --exclude="$(basename "$ROOT")/.git" --exclude="$(basename "$ROOT")/.target" \
    "$(basename "$ROOT")"
tar --sort=name --mtime="@${SOURCE_DATE_EPOCH:-0}" --owner=0 --group=0 --numeric-owner \
    -czf "$LINUX_ARCHIVE" -C "$DIST" "flamewm-$VERSION"
ARTIFACTS=("$SOURCE_ARCHIVE" "$LINUX_ARCHIVE")
[[ -f "$DEB" ]] && ARTIFACTS+=("$DEB")
sha256sum "${ARTIFACTS[@]}" | sed "s#  $DIST/#  #" > "$DIST/SHA256SUMS"
printf 'OK package: %s\n' "$DIST"
