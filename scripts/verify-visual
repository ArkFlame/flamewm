#!/usr/bin/env bash
set -euo pipefail
SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
ROOT="$(cd "$(dirname "$SCRIPT_PATH")/.." && pwd -P)"
cd "$ROOT"

command -v Xephyr >/dev/null || { echo "Xephyr is required" >&2; exit 1; }
command -v cargo >/dev/null || { echo "cargo is required" >&2; exit 1; }
command -v xdpyinfo >/dev/null || { echo "xdpyinfo is required" >&2; exit 1; }
command -v xwininfo >/dev/null || { echo "xwininfo is required" >&2; exit 1; }

# ImageMagick 7 normally exposes X11 capture as `magick import`; many systems
# no longer install the legacy standalone `import` compatibility executable.
# ImageMagick 6 commonly exposes standalone import/identify/compare commands.
# Support both layouts.  `xwd` is a final capture fallback when ImageMagick was
# built without its X11 delegate.
if command -v magick >/dev/null 2>&1; then
  IM_MODE=magick7
elif command -v identify >/dev/null 2>&1 && command -v compare >/dev/null 2>&1; then
  IM_MODE=legacy
else
  echo "ImageMagick is required for visual comparison (ImageMagick 7 'magick', or legacy identify+compare)" >&2
  exit 1
fi

im_identify() {
  if [[ "$IM_MODE" == magick7 ]]; then magick identify "$@"; else identify "$@"; fi
}
im_compare() {
  if [[ "$IM_MODE" == magick7 ]]; then magick compare "$@"; else compare "$@"; fi
}
im_convert() {
  if [[ "$IM_MODE" == magick7 ]]; then magick "$@"; else convert "$@"; fi
}

DISPLAY_NUM="${FLAMEWM_VISUAL_DISPLAY:-:98}"
SCREEN=1350x641
OUT="${FLAMEWM_VISUAL_OUTPUT:-.target/flamewm/visual-current.png}"
REF="${FLAMEWM_VISUAL_REFERENCE:-project_sources/visual/user-rwr-0.0.6-xephyr.png}"
# Optional canary harness sampling (SR08 black-pixel gate) on the visual display.
# Off unless FLAMEWM_VISUAL_CANARY=1; never changes the reference comparison.
VISUAL_CANARY="${FLAMEWM_VISUAL_CANARY:-0}"
mkdir -p .target/flamewm "$(dirname "$OUT")"

export RWR_UI_FONT="${RWR_UI_FONT:-IBM Plex Sans}"
if [[ -z "${RWR_FONT_FILES:-}" ]]; then
  FONT_FILES="$(./scripts/prepare-ibm-plex || true)"
  if [[ -n "$FONT_FILES" ]]; then export RWR_FONT_FILES="$FONT_FILES"; fi
fi

cargo build --quiet --release -p flamewm-render-compiler --bin flamewm-render-compile
cargo build --quiet --release -p flamewm-shell
./.target/release/flamewm-render-compile -o .target/flamewm/flamewm-v8.rwr ui/index.html

Xephyr "$DISPLAY_NUM" -screen "$SCREEN" -dpi 96 -ac -br -reset >/tmp/flamewm-render-visual-xephyr.log 2>&1 &
XPID=$!
APID=''
cleanup() {
  [[ -n "$APID" ]] && kill "$APID" 2>/dev/null || true
  kill "$XPID" 2>/dev/null || true
}
trap cleanup EXIT INT TERM
ready=0
for _ in $(seq 1 50); do
  if DISPLAY="$DISPLAY_NUM" xdpyinfo >/dev/null 2>&1; then
    ready=1
    break
  fi
  if ! kill -0 "$XPID" 2>/dev/null; then
    cat /tmp/flamewm-render-visual-xephyr.log >&2 || true
    echo "Xephyr exited before becoming ready" >&2
    exit 1
  fi
  sleep 0.1
done
if [[ "$ready" != 1 ]]; then
  cat /tmp/flamewm-render-visual-xephyr.log >&2 || true
  echo "Xephyr did not become ready on $DISPLAY_NUM" >&2
  exit 1
fi

DISPLAY="$DISPLAY_NUM" ./.target/release/flamewm-shell >/tmp/flamewm-render-visual-app.log 2>&1 &
APID=$!

# Wait for the full-size demo window to be mapped and painted.
mapped=0
for _ in $(seq 1 50); do
  if DISPLAY="$DISPLAY_NUM" xwininfo -root -tree 2>/dev/null | grep -q '1350x641'; then
    mapped=1
    break
  fi
  if ! kill -0 "$APID" 2>/dev/null; then
    cat /tmp/flamewm-render-visual-app.log >&2 || true
    echo "FlameWM WebRender shell exited before its window was mapped" >&2
    exit 1
  fi
  sleep 0.1
done
if [[ "$mapped" != 1 ]]; then
  cat /tmp/flamewm-render-visual-app.log >&2 || true
  echo "FlameWM WebRender shell window did not reach 1350x641" >&2
  exit 1
fi
sleep 0.20

capture_root() {
  # Preferred on ImageMagick 7. This is the documented replacement for the
  # standalone ImageMagick 6 `import` command.
  if [[ "$IM_MODE" == magick7 ]]; then
    if DISPLAY="$DISPLAY_NUM" magick import -window root "$OUT" >/tmp/flamewm-render-visual-capture.log 2>&1; then
      return 0
    fi
  fi

  # Compatibility path for ImageMagick 6 or distributions that still ship the
  # direct executable separately.
  if command -v import >/dev/null 2>&1; then
    if DISPLAY="$DISPLAY_NUM" import -window root "$OUT" >/tmp/flamewm-render-visual-capture.log 2>&1; then
      return 0
    fi
  fi

  # Some ImageMagick builds omit the X11 import delegate.  xwd captures the X
  # root independently; ImageMagick is then used only to decode XWD -> PNG.
  if command -v xwd >/dev/null 2>&1; then
    local xwd_file=".target/flamewm/visual-current.xwd"
    if DISPLAY="$DISPLAY_NUM" xwd -root -silent -out "$xwd_file" >/tmp/flamewm-render-visual-capture.log 2>&1 \
       && im_convert "$xwd_file" "$OUT" >>/tmp/flamewm-render-visual-capture.log 2>&1; then
      rm -f "$xwd_file"
      return 0
    fi
  fi

  cat /tmp/flamewm-render-visual-capture.log >&2 2>/dev/null || true
  echo "VISUAL_FAIL no working X11 screenshot backend. Install an ImageMagick build with X11 import support or x11-apps (xwd)." >&2
  return 1
}

capture_root

if [[ "$VISUAL_CANARY" == 1 ]]; then
  CANARY_BIN="${CANARY_BIN:-./.target/release/flamewm-x11-canary}"
  if [[ ! -x "$CANARY_BIN" ]]; then
    echo '[visual-canary] building flamewm-x11-canary harness' >&2
    cargo build --quiet --release -p flamewm-x11-canary
  fi
  # SR08 black-pixel gate on the visual display; fails the run on all-black root.
  DISPLAY="$DISPLAY_NUM" "$CANARY_BIN" sr08 || { echo "VISUAL_FAIL canary SR08 black-pixel gate" >&2; exit 1; }
fi

# Reference and current must be compared without resizing; geometry drift is a failure.
CUR_GEOM="$(im_identify -format '%wx%h' "$OUT")"
REF_GEOM="$(im_identify -format '%wx%h' "$REF")"
[[ "$CUR_GEOM" == "$REF_GEOM" ]] || { echo "VISUAL_FAIL geometry current=$CUR_GEOM reference=$REF_GEOM" >&2; exit 1; }

RMSE="$(im_compare -metric RMSE "$REF" "$OUT" null: 2>&1 || true)"
AE="$(im_compare -metric AE "$REF" "$OUT" null: 2>&1 || true)"
printf 'VISUAL_REFERENCE %s\n' "$REF"
printf 'VISUAL_CURRENT   %s\n' "$OUT"
printf 'VISUAL_RMSE      %s\n' "$RMSE"
printf 'VISUAL_AE        %s\n' "$AE"
